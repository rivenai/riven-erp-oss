<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission Plan Tree View -->
    <record id="view_commission_plan_tree" model="ir.ui.view">
        <field name="name">villeside.commission.plan.tree</field>
        <field name="model">villeside.commission.plan</field>
        <field name="arch" type="xml">
            <tree string="Commission Plans">
                <field name="name"/>
                <field name="plan_type"/>
                <field name="agent_split_pct"/>
                <field name="broker_split_pct"/>
                <field name="annual_cap"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Commission Plan Form View -->
    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">villeside.commission.plan.form</field>
        <field name="model">villeside.commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan Name"/></h1>
                    </div>
                    <group>
                        <group string="Plan Configuration">
                            <field name="plan_type"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Split Configuration">
                            <field name="agent_split_pct"/>
                            <field name="broker_split_pct"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cap Settings" attrs="{'invisible': [('plan_type','!=','capped')]}">
                            <field name="annual_cap"/>
                            <field name="post_cap_agent_pct"/>
                        </group>
                        <group string="Flat Fee" attrs="{'invisible': [('plan_type','!=','flat_fee')]}">
                            <field name="flat_fee_per_txn"/>
                        </group>
                    </group>
                    <group string="Additional Fees">
                        <group>
                            <field name="transaction_fee"/>
                            <field name="admin_fee"/>
                        </group>
                        <group>
                            <field name="eo_insurance_fee"/>
                            <field name="desk_fee"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Volume Tiers" attrs="{'invisible': [('plan_type','!=','tiered')]}">
                            <field name="tier_line_ids">
                                <tree editable="bottom">
                                    <field name="min_volume"/>
                                    <field name="max_volume"/>
                                    <field name="agent_split_pct"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Commission Lines">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Plan Search View -->
    <record id="view_commission_plan_search" model="ir.ui.view">
        <field name="name">villeside.commission.plan.search</field>
        <field name="model">villeside.commission.plan</field>
        <field name="arch" type="xml">
            <search string="Commission Plans">
                <field name="name"/>
                <field name="plan_type"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Plan Type" context="{'group_by':'plan_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Commission Plan Action -->
    <record id="action_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">villeside.commission.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_commission_plan_search"/>
    </record>
</odoo>