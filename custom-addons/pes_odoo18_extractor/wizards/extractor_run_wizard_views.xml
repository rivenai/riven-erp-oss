<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_extractor_run_wizard_form" model="ir.ui.view">
        <field name="name">pes.extractor.run.wizard.form</field>
        <field name="model">pes.extractor.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Launch Odoo 18 Extraction">
                <sheet>
                    <div class="oe_title">
                        <h1>Pull from Odoo 18 (Read-Only)</h1>
                        <p>This will fetch records from the legacy Odoo 18
                        instance via XML-RPC. Data lands in <b>staging tables</b>
                        only — no live posting.</p>
                    </div>
                    <group>
                        <group string="What to pull">
                            <field name="pull_partners"/>
                            <field name="pull_products"/>
                            <field name="pull_sale_orders"/>
                            <field name="pull_invoices"/>
                            <field name="pull_payments"/>
                        </group>
                        <group string="Filter">
                            <field name="cutoff_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_launch" type="object"
                            string="Launch Extraction" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_extractor_run_wizard" model="ir.actions.act_window">
        <field name="name">New Extraction Run</field>
        <field name="res_model">pes.extractor.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
