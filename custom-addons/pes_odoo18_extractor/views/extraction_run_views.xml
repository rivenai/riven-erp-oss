<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_extraction_run_tree" model="ir.ui.view">
        <field name="name">pes.extraction.run.list</field>
        <field name="model">pes.extraction.run</field>
        <field name="arch" type="xml">
            <list string="Extraction Runs" decoration-success="state=='completed'"
                  decoration-danger="state=='failed'" decoration-muted="state=='archived'">
                <field name="display_name"/>
                <field name="state"/>
                <field name="triggered_by_id"/>
                <field name="started_at"/>
                <field name="duration_seconds"/>
                <field name="partner_count"/>
                <field name="product_count"/>
                <field name="sale_order_count"/>
                <field name="invoice_count"/>
                <field name="payment_count"/>
            </list>
        </field>
    </record>

    <record id="view_extraction_run_form" model="ir.ui.view">
        <field name="name">pes.extraction.run.form</field>
        <field name="model">pes.extraction.run</field>
        <field name="arch" type="xml">
            <form string="Extraction Run">
                <header>
                    <button name="action_run" type="object" string="Run"
                            class="btn-primary" invisible="state in ('running','completed','archived')"/>
                    <button name="action_archive_run" type="object"
                            string="Archive Run + Staged Data" class="btn-warning"
                            invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="triggered_by_id" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="duration_seconds" readonly="1"/>
                        </group>
                        <group string="Pull Scope">
                            <field name="pull_partners"/>
                            <field name="pull_products"/>
                            <field name="pull_sale_orders"/>
                            <field name="pull_invoices"/>
                            <field name="pull_payments"/>
                            <field name="cutoff_date"/>
                        </group>
                    </group>
                    <group string="Counts">
                        <group>
                            <field name="partner_count" readonly="1"/>
                            <field name="product_count" readonly="1"/>
                            <field name="sale_order_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_count" readonly="1"/>
                            <field name="payment_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Errors" invisible="not error_log">
                        <field name="error_log" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_extraction_run" model="ir.actions.act_window">
        <field name="name">Extraction Runs</field>
        <field name="res_model">pes.extraction.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
