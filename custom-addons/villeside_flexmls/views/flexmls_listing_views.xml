<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Listing Form View -->
    <record id="view_flexmls_listing_form" model="ir.ui.view">
        <field name="name">flexmls.listing.form</field>
        <field name="model">flexmls.listing</field>
        <field name="arch" type="xml">
            <form string="MLS Listing">
                <header>
                    <button name="action_sync_from_spark" type="object" string="Sync from Spark" class="btn-primary" icon="fa-refresh"/>
                    <field name="mls_status" widget="statusbar" statusbar_visible="active,pending,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Listing Info">
                            <field name="mls_id"/>
                            <field name="spark_id"/>
                            <field name="property_type"/>
                            <field name="list_price" widget="monetary"/>
                            <field name="original_price" widget="monetary"/>
                            <field name="sold_price" widget="monetary"/>
                            <field name="price_per_sqft"/>
                        </group>
                        <group string="Address">
                            <field name="street_address"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="zip_code"/>
                            <field name="county"/>
                            <field name="subdivision"/>
                        </group>
                    </group>
                    <group>
                        <group string="Property Details">
                            <field name="bedrooms"/>
                            <field name="bathrooms_full"/>
                            <field name="bathrooms_half"/>
                            <field name="sqft"/>
                            <field name="lot_size"/>
                            <field name="year_built"/>
                            <field name="stories"/>
                            <field name="garage_spaces"/>
                        </group>
                        <group string="Dates &amp; Media">
                            <field name="list_date"/>
                            <field name="sold_date"/>
                            <field name="last_synced"/>
                            <field name="primary_photo_url" widget="url"/>
                            <field name="virtual_tour_url" widget="url"/>
                            <field name="website_published"/>
                            <field name="website_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Agent Info">
                        <field name="listing_agent_name"/>
                        <field name="listing_agent_phone"/>
                        <field name="listing_office"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Photos (JSON)">
                            <field name="photo_urls"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Listing Tree View -->
    <record id="view_flexmls_listing_tree" model="ir.ui.view">
        <field name="name">flexmls.listing.tree</field>
        <field name="model">flexmls.listing</field>
        <field name="arch" type="xml">
            <tree string="MLS Listings" decoration-success="mls_status=='active'" decoration-warning="mls_status=='pending'" decoration-muted="mls_status in ('sold','expired','withdrawn')">
                <field name="mls_id"/>
                <field name="name"/>
                <field name="city"/>
                <field name="property_type"/>
                <field name="list_price" widget="monetary"/>
                <field name="bedrooms"/>
                <field name="bathrooms_full"/>
                <field name="sqft"/>
                <field name="mls_status"/>
                <field name="list_date"/>
                <field name="website_published"/>
            </tree>
        </field>
    </record>

    <!-- Listing Search View -->
    <record id="view_flexmls_listing_search" model="ir.ui.view">
        <field name="name">flexmls.listing.search</field>
        <field name="model">flexmls.listing</field>
        <field name="arch" type="xml">
            <search string="Search Listings">
                <field name="name"/>
                <field name="mls_id"/>
                <field name="city"/>
                <field name="zip_code"/>
                <field name="subdivision"/>
                <filter string="Active" name="active" domain="[('mls_status','=','active')]"/>
                <filter string="Pending" name="pending" domain="[('mls_status','=','pending')]"/>
                <filter string="Sold" name="sold" domain="[('mls_status','=','sold')]"/>
                <filter string="Published" name="published" domain="[('website_published','=',True)]"/>
                <separator/>
                <filter string="Residential" name="residential" domain="[('property_type','=','residential')]"/>
                <filter string="Commercial" name="commercial" domain="[('property_type','=','commercial')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'mls_status'}"/>
                    <filter string="Property Type" name="group_type" context="{'group_by':'property_type'}"/>
                    <filter string="City" name="group_city" context="{'group_by':'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Listing Kanban View -->
    <record id="view_flexmls_listing_kanban" model="ir.ui.view">
        <field name="name">flexmls.listing.kanban</field>
        <field name="model">flexmls.listing</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="list_price"/>
                <field name="mls_status"/>
                <field name="primary_photo_url"/>
                <field name="bedrooms"/>
                <field name="bathrooms_full"/>
                <field name="sqft"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image" t-if="record.primary_photo_url.raw_value">
                                <img t-att-src="record.primary_photo_url.raw_value" alt="Property" style="max-width:100px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><strong>$<field name="list_price"/></strong></div>
                                <div><field name="bedrooms"/> bd | <field name="bathrooms_full"/> ba | <field name="sqft"/> sqft</div>
                                <div><field name="mls_status" widget="badge" decoration-success="mls_status=='active'" decoration-warning="mls_status=='pending'"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Listing Action -->
    <record id="action_flexmls_listing" model="ir.actions.act_window">
        <field name="name">MLS Listings</field>
        <field name="res_model">flexmls.listing</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_flexmls_listing_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>