import logging, requests
from odoo import _
_logger = logging.getLogger(__name__)

class AvaTaxClient:
    def __init__(self, company):
        self.company = company
        p = company.env['ir.config_parameter'].sudo()
        self.api_id = p.get_param('taxcloud.api_id', '')
        self.api_key = p.get_param('taxcloud.api_key', '')
    def _headers(self): return {'Content-Type':'application/json','Accept':'application/json'}
    def _auth(self): return {'apiLoginID':self.api_id,'apiKey':self.api_key}
    def calculate_tax(self, partner, lines, doc_code=None):
        if not self.api_id: return {'tax_amount':0.0,'tax_rate':0.0,'lines':[]}
        z = (partner.zip or '00000').replace('-','').replace(' ','')
        payload = {**self._auth(), 'customerID':str(partner.id), 'cartID':doc_code or 'pes',
                   'origin':{'Address1':self.company.street or '','City':self.company.city or '','State':self.company.state_id.code or 'OR','Zip5':(self.company.zip or '97201')[:5],'Zip4':'0000'},
                   'destination':{'Address1':partner.street or '','City':partner.city or '','State':partner.state_id.code or '','Zip5':z[:5].zfill(5),'Zip4':'0000'},
                   'cartItems':[{'Index':i,'ItemID':str(i),'TIC':line.get('tic','00000'),'Price':float(line.get('amount',0)),'Qty':float(line.get('qty',1))} for i,line in enumerate(lines)],
                   'deliveredBySeller':False}
        try:
            r = requests.post('https://api.taxcloud.net/1.0/TaxCloud/Lookup', json=payload, headers=self._headers(), timeout=10)
            d = r.json()
            if d.get('ResponseType') != 3: return {'tax_amount':0.0,'tax_rate':0.0,'lines':[]}
            total = sum(float(it.get('TaxAmount',0)) for it in d.get('CartItemsResponse',[]))
            return {'tax_amount':total, 'tax_rate':0.0, 'lines':[]}
        except: return {'tax_amount':0.0,'tax_rate':0.0,'lines':[]}
    def avalara_commit(self, doc_code): return True
    def avalara_void(self, doc_code): return True
    def ping(self): return True
