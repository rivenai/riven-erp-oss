<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         PRINCIPAL ENTITY views
         ========================================================= -->
    <record id="view_pes_principal_entity_tree" model="ir.ui.view">
        <field name="name">pes.principal.entity.list</field>
        <field name="model">pes.principal.entity</field>
        <field name="arch" type="xml">
            <list string="Principal Entities">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="jurisdiction"/>
                <field name="sez_status" widget="boolean_toggle"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pes_principal_entity_form" model="ir.ui.view">
        <field name="name">pes.principal.entity.form</field>
        <field name="model">pes.principal.entity</field>
        <field name="arch" type="xml">
            <form string="Principal Entity">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="jurisdiction"/>
                            <field name="sez_status"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pes_principal_entity" model="ir.actions.act_window">
        <field name="name">Principal Entities</field>
        <field name="res_model">pes.principal.entity</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================================================
         COST CENTER views
         ========================================================= -->
    <record id="view_pes_cost_center_tree" model="ir.ui.view">
        <field name="name">pes.cost.center.list</field>
        <field name="model">pes.cost.center</field>
        <field name="arch" type="xml">
            <list string="Cost Centers">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="region"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pes_cost_center_form" model="ir.ui.view">
        <field name="name">pes.cost.center.form</field>
        <field name="model">pes.cost.center</field>
        <field name="arch" type="xml">
            <form string="Cost Center">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="region"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pes_cost_center" model="ir.actions.act_window">
        <field name="name">Cost Centers</field>
        <field name="res_model">pes.cost.center</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================================================
         REVENUE TRACK views
         ========================================================= -->
    <record id="view_pes_revenue_track_tree" model="ir.ui.view">
        <field name="name">pes.revenue.track.list</field>
        <field name="model">pes.revenue.track</field>
        <field name="arch" type="xml">
            <list string="Revenue Tracks">
                <field name="track_number"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pes_revenue_track_form" model="ir.ui.view">
        <field name="name">pes.revenue.track.form</field>
        <field name="model">pes.revenue.track</field>
        <field name="arch" type="xml">
            <form string="Revenue Track">
                <sheet>
                    <group>
                        <field name="track_number"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pes_revenue_track" model="ir.actions.act_window">
        <field name="name">Revenue Tracks</field>
        <field name="res_model">pes.revenue.track</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================================================
         DIMENSION RULE views
         ========================================================= -->
    <record id="view_pes_dimension_rule_tree" model="ir.ui.view">
        <field name="name">pes.dimension.rule.list</field>
        <field name="model">pes.dimension.rule</field>
        <field name="arch" type="xml">
            <list string="Auto-Tag Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="counterparty_regex"/>
                <field name="mercury_memo_regex"/>
                <field name="principal_entity_id"/>
                <field name="cost_center_id"/>
                <field name="revenue_track_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pes_dimension_rule_form" model="ir.ui.view">
        <field name="name">pes.dimension.rule.form</field>
        <field name="model">pes.dimension.rule</field>
        <field name="arch" type="xml">
            <form string="Dimension Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Match Conditions (all AND'd)">
                        <group>
                            <field name="mercury_memo_regex"/>
                            <field name="counterparty_regex"/>
                            <field name="mercury_account_kind"/>
                        </group>
                        <group>
                            <field name="amount_min"/>
                            <field name="amount_max"/>
                            <field name="journal_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Apply These Dimensions">
                        <group>
                            <field name="principal_entity_id"/>
                            <field name="cost_center_id"/>
                        </group>
                        <group>
                            <field name="revenue_track_id"/>
                            <field name="intercompany_partner_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pes_dimension_rule" model="ir.actions.act_window">
        <field name="name">Auto-Tag Rules</field>
        <field name="res_model">pes.dimension.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================================================
         account.move.line — surface the four dimensions in tree + form
         ========================================================= -->
    <record id="view_move_line_tree_pes_dimensions" model="ir.ui.view">
        <field name="name">account.move.line.list.pes.dimensions</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="pes_principal_entity_id" optional="show"/>
                <field name="pes_cost_center_id" optional="show"/>
                <field name="pes_revenue_track_id" optional="hide"/>
                <field name="pes_intercompany_partner_id" optional="hide"/>
                <field name="pes_dimensions_source" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- =========================================================
         MENU — under Accounting / Configuration / Forensic Dimensions
         ========================================================= -->
    <menuitem id="menu_pes_forensic_root"
              name="Forensic Dimensions"
              parent="account.menu_finance_configuration"
              sequence="85"/>

    <menuitem id="menu_pes_principal_entity"
              name="Principal Entities"
              parent="menu_pes_forensic_root"
              action="action_pes_principal_entity"
              sequence="10"/>

    <menuitem id="menu_pes_cost_center"
              name="Cost Centers"
              parent="menu_pes_forensic_root"
              action="action_pes_cost_center"
              sequence="20"/>

    <menuitem id="menu_pes_revenue_track"
              name="Revenue Tracks"
              parent="menu_pes_forensic_root"
              action="action_pes_revenue_track"
              sequence="30"/>

    <menuitem id="menu_pes_dimension_rule"
              name="Auto-Tag Rules"
              parent="menu_pes_forensic_root"
              action="action_pes_dimension_rule"
              sequence="40"/>

</odoo>
