<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_mercury" model="ir.ui.view">
        <field name="name">account.journal.form.mercury</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Mercury Sync" invisible="not is_mercury_journal">
                    <field name="is_mercury_journal" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
