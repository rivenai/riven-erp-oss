<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company record rule for account.online.link Mercury rows.
            The base account_online_synchronization module already defines a
            company-scoped rule on account.online.link; we only add a hardening
            rule that prevents non-accounting users from reading Mercury links
            with stored error payloads (which may contain partial token hints).
        -->
        <record id="rule_mercury_link_account_user" model="ir.rule">
            <field name="name">Mercury links: accounting users only</field>
            <field name="model_id" ref="account_online_synchronization.model_account_online_link"/>
            <field name="domain_force">[('is_mercury','=',False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
